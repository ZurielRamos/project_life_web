# URL base de la API pública (NestJS). Incluye el prefijo /api.
# En desarrollo la API corre en http://localhost:3000/api
PUBLIC_API_URL=http://localhost:3000/api
# URL base pública del sitio (sin barra final). Se usa para construir URLs
# absolutas: canonical, Open Graph y Twitter Cards. Configúrala con el dominio
# final en producción (p. ej. https://www.inkttex.com).
PUBLIC_SITE_URL=https://www.inkttex.com

# Redes sociales del footer. Cada icono SOLO aparece si su variable está
# definida (no hay valores por defecto). Deja en blanco o elimina la línea
# para ocultar ese icono. Usa la URL completa del perfil.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/inkttex
PUBLIC_FACEBOOK_URL=https://www.facebook.com/inkttex
PUBLIC_TIKTOK_URL=https://www.tiktok.com/@inkttex
# WhatsApp: número en formato internacional, solo dígitos (código de país + número).
# El footer construye el enlace https://wa.me/<numero> automáticamente.
PUBLIC_WHATSAPP_PHONE=573207104999
# Correo de contacto (se muestra como icono de email con enlace mailto:).
PUBLIC_CONTACT_EMAIL=hola@inkttex.com
