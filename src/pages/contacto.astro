---
import '../styles/info-page.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNotFound from '../components/PageNotFound.astro';
import { getBrand } from '../lib/brand';

// Página de contacto: los canales salen de la configuración de la tienda.
const brand = getBrand(Astro.locals.store);
const contact = brand.site.contact;

if (!contact.enabled) {
  Astro.response.status = 404;
}

const wa = brand.whatsappDigits;
const whatsappHref = wa
  ? `https://wa.me/${wa}?text=${encodeURIComponent(contact.whatsappMessage)}`
  : null;
const telDigits = (brand.phone ?? '').replace(/[^\d+]/g, '');
const hoursLines = contact.hours.split('\n').map((l) => l.trim()).filter(Boolean);
const showForm = contact.showForm && Boolean(wa);

const socials = [
  brand.instagram && { name: 'Instagram', href: brand.instagram },
  brand.facebook && { name: 'Facebook', href: brand.facebook },
  brand.tiktok && { name: 'TikTok', href: brand.tiktok },
].filter(Boolean) as { name: string; href: string }[];
---
<Layout
  title={contact.enabled ? `${contact.title} — ${brand.name}` : `Página no encontrada — ${brand.name}`}
  description={contact.intro || undefined}
  noindex={!contact.enabled}
>
  <Header solid />
  {contact.enabled ? (
    <main class="info-page">
      <div class="info-page-inner">
        <h1 class="info-title">{contact.title}</h1>
        {contact.intro && <p class="info-intro">{contact.intro}</p>}

        <div class="channels">
          {whatsappHref && (
            <a class="channel channel--wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">
              <span class="channel-label">WhatsApp</span>
              <span class="channel-value">Escríbenos ahora</span>
            </a>
          )}
          {brand.contactEmail && (
            <a class="channel" href={`mailto:${brand.contactEmail}`}>
              <span class="channel-label">Correo</span>
              <span class="channel-value">{brand.contactEmail}</span>
            </a>
          )}
          {brand.phone && (
            <a class="channel" href={`tel:${telDigits}`}>
              <span class="channel-label">Teléfono</span>
              <span class="channel-value">{brand.phone}</span>
            </a>
          )}
          {brand.address && (
            <div class="channel channel--static">
              <span class="channel-label">Dirección</span>
              <span class="channel-value">{brand.address}</span>
            </div>
          )}
          {hoursLines.length > 0 && (
            <div class="channel channel--static">
              <span class="channel-label">Horario</span>
              <span class="channel-value">
                {hoursLines.map((line) => <span class="hours-line">{line}</span>)}
              </span>
            </div>
          )}
        </div>

        {socials.length > 0 && (
          <p class="socials">
            Síguenos en
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>
            ))}
          </p>
        )}

        {showForm && (
          <section class="form-card" aria-labelledby="contact-form-title">
            <h2 id="contact-form-title" class="block-title">Déjanos tu mensaje</h2>
            <form
              class="form"
              action={`https://wa.me/${wa}`}
              method="get"
              target="_blank"
              data-contact-form
              data-phone={wa}
              data-intro={contact.whatsappMessage}
            >
              <label class="field">
                <span>Tu nombre</span>
                <input type="text" name="name" autocomplete="name" maxlength="80" />
              </label>
              <label class="field">
                <span>Mensaje</span>
                <textarea name="text" rows="5" maxlength="800" required>{contact.whatsappMessage}</textarea>
              </label>
              <button type="submit" class="submit">{contact.formButtonLabel}</button>
              <p class="form-note">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
            </form>
          </section>
        )}

        {contact.mapEmbedUrl && (
          <div class="map">
            <iframe
              src={contact.mapEmbedUrl}
              title={`Mapa de ${brand.name}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        )}

        {contact.faqs.length > 0 && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title" class="block-title">{contact.faqTitle}</h2>
            {contact.faqs.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )}
      </div>
    </main>
  ) : (
    <PageNotFound />
  )}
  <Footer />
</Layout>
<script>
  // Compone el mensaje de WhatsApp con el nombre y abre el chat. Sin JS el
  // formulario envía solo el texto del mensaje (campo "text").
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const text = String(data.get('text') ?? '').trim();
    if (!text) return;
    const message = name ? `${text}\n\n— ${name}` : text;
    const url = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(18, 18, 15, 0.08);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  a.channel:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  a.channel:focus-visible {
    outline: 3px solid rgba(var(--accent-rgb), 0.5);
    outline-offset: 3px;
  }
  .channel--wa {
    background: #12120f;
    color: #fff;
    border-color: #12120f;
  }
  .channel-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a80;
  }
  .channel--wa .channel-label {
    color: rgba(255, 255, 255, 0.65);
  }
  .channel-value {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .hours-line {
    display: block;
    font-weight: 500;
  }
  .socials {
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    color: #5c5c54;
  }
  .socials a {
    color: #12120f;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .block-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .form-card,
  .faq {
    margin-top: 2.5rem;
  }
  .form {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .field input,
  .field textarea {
    border: 1px solid rgba(18, 18, 15, 0.18);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
    font: inherit;
    font-weight: 400;
    background: #fff;
    color: #12120f;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.2);
  }
  .submit {
    justify-self: start;
    border: 0;
    border-radius: 999px;
    padding: 0.85rem 1.7rem;
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent) 40%, var(--accent-2) 100%);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .submit:hover {
    filter: brightness(1.08);
  }
  .submit:focus-visible {
    outline: 3px solid rgba(var(--accent-rgb), 0.5);
    outline-offset: 3px;
  }
  .form-note {
    margin: 0;
    font-size: 0.8rem;
    color: #6b6b63;
  }
  .map {
    margin-top: 2.5rem;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(18, 18, 15, 0.08);
  }
  .map iframe {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
  }
  .faq-item {
    border-top: 1px solid rgba(18, 18, 15, 0.12);
    padding: 1rem 0;
  }
  .faq-item:last-child {
    border-bottom: 1px solid rgba(18, 18, 15, 0.12);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    list-style-position: outside;
  }
  .faq-item summary:focus-visible {
    outline: 3px solid rgba(var(--accent-rgb), 0.5);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .faq-item p {
    margin: 0.75rem 0 0;
    color: #4a4a43;
    line-height: 1.65;
  }
</style>
