---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getStorefrontDesign, formatPrice, FIT_META } from '../../lib/storefront';
import { getBrand, getRequestOrigin } from '../../lib/brand';
const brand = getBrand(Astro.locals.store);

const slug = Astro.params.slug as string;
const product = await getStorefrontDesign(slug, Astro.locals.store?.slug);

if (!product) {
  return Astro.redirect('/tienda', 302);
}

// Precio por talla con fallback al precio base del producto. La talla
// inicial (índice 0) define el precio mostrado al cargar.
const sizePriceCents = (s: { priceCents: number | null }): number | null =>
  s.priceCents ?? product.priceCents;
const initialSize = product.sizes[0] ?? null;
const price = formatPrice(
  initialSize ? sizePriceCents(initialSize) : product.priceCents,
  product.currency,
  brand.locale,
);
const subtitle = product.fit ? `${FIT_META[product.fit].label}` : null;

// Guía de tallas: hay tabla si existen columnas y alguna talla con medidas.
const sizeChartColumns = product.sizeChartColumns ?? [];
const sizeUnit = product.sizeChartUnit ?? '';
const hasSizeGuide =
  sizeChartColumns.length > 0 &&
  product.sizes.some(
    (s) => s.measurements && Object.keys(s.measurements).length > 0,
  );

// WhatsApp: número de la tienda (solo dígitos). Si la tienda no tiene, queda
// vacío y el cliente usa el diálogo de compartir en vez del chat directo.
const whatsappPhone = brand.whatsappDigits;
// URL absoluta del producto con el host real de la tienda (subdominio o dominio).
const productUrl = new URL(
  Astro.url.pathname,
  getRequestOrigin(Astro.request, Astro.url),
).href;
const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const createdAt = product.createdAt ? new Date(product.createdAt).getTime() : NaN;
const isNew = Number.isFinite(createdAt) && Date.now() - createdAt < WEEK_MS;

const colors = product.colors.filter((c) => c.images.length > 0);
const initial = colors[0];
// Duplicamos las imágenes para el marquee infinito sin cortes.
const marquee = [...(initial?.images ?? []), ...(initial?.images ?? [])];
---

<Layout
  title={`${product.name} — ${brand.name}`}
  description={product.description ?? undefined}
  image={product.cover ?? initial?.images[0] ?? undefined}
  ogType="product"
>
  <Header solid hideOnMobile />

  <main class="pdp" data-pdp>
    <!-- Botón volver flotante (solo mobile, donde se oculta el header). -->
    <button type="button" class="back-fab" data-back aria-label="Volver">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>

    <!-- Escenario de imágenes.
         Desktop: marquee automático horizontal.
         Mobile: carrusel con swipe (scroll-snap), sin autoplay. -->
    <div class="stage">
      <div class="marquee" data-marquee>
        {marquee.map((url, i) => (
          <div class="slide">
            <img
              src={url}
              alt={`${product.name} ${(i % (initial?.images.length || 1)) + 1}`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>

      <!-- Carrusel solo-mobile: una imagen por vista, swipe horizontal -->
      <div class="carousel" data-carousel>
        {(initial?.images ?? []).map((url, i) => (
          <div class="carousel-slide">
            <img
              src={url}
              alt={`${product.name} ${i + 1}`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
      <!-- Puntos indicadores del carrusel (mobile) -->
      <div class="dots" data-dots>
        {(initial?.images ?? []).map((_, i) => (
          <span class:list={['dot', { active: i === 0 }]}></span>
        ))}
      </div>

    </div>

    <!-- Panel flotante: cards ligeramente grises -->
    <aside class="panel">
      <!-- Card: título + descripción -->
      <div class="card-info">
        <div class="card-head">
          <div>
            <h1 class="p-title">{product.name}</h1>
            {subtitle && <p class="p-subtitle">{subtitle}</p>}
            {product.code && <p class="p-code">Cód. {product.code}</p>}
          </div>
          {isNew && <span class="p-badge">NUEVO</span>}
        </div>
        {product.description && <p class="p-desc">{product.description}</p>}
      </div>

      <!-- Card: color -->
      {colors.length > 0 && (
        <div class="card-info">
          <div class="p-block-head">
            <span>Color: <strong data-color-label>{initial?.name ?? ''}</strong></span>
          </div>
          <div class="swatches" data-swatches>
            {colors.map((c, i) => (
              <button
                type="button"
                class:list={['swatch', { active: i === 0 }]}
                style={`--c:${c.hex ?? '#ccc'}`}
                data-color-id={c.id ?? ''}
                data-color-hex={c.hex ?? ''}
                data-color-name={c.name ?? ''}
                data-images={JSON.stringify(c.images)}
                title={c.name ?? ''}
                aria-label={c.name ?? 'Color'}
              ></button>
            ))}
          </div>
        </div>
      )}

      <!-- Card: talla -->
      {product.sizes.length > 0 && (
        <div class="card-info">
          <div class="p-block-head">
            <span>Talla</span>
            {hasSizeGuide && (
              <button type="button" class="link-btn" data-size-guide-open>
                Guía de tallas
              </button>
            )}
          </div>
          <div class="sizes" data-sizes>
            {product.sizes.map((s, i) => (
              <button
                type="button"
                class:list={['size', { active: i === 0 }]}
                data-size={s.name}
                data-price={
                  formatPrice(sizePriceCents(s), product.currency, brand.locale) ??
                  'Consultar'
                }
              >
                {s.label ?? s.name}
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Card: compra (desktop en el panel; mobile anclada abajo via CSS) -->
      <div class="card-info card-buy" data-buy-card>
        <div class="p-buy">
          <span class="p-price" data-price-display>{price ?? 'Consultar'}</span>
          <button
            type="button"
            class="buy-btn"
            data-buy
            data-phone={whatsappPhone}
            data-name={product.name}
            data-code={product.code ?? ''}
            data-url={productUrl}
          >
            <svg class="wa-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.02zM12.04 20.15h-.003a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43l-.48-.01c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"></path>
            </svg>
            <span>Comprar</span>
          </button>
        </div>
        <p class="p-note">Te atendemos por WhatsApp para completar tu pedido.</p>
      </div>

      <button type="button" class="custom-btn" data-custom-open>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>
        </svg>
        Crea tu propia camiseta
      </button>
      <script
        type="application/json"
        data-custom-payload
        set:html={JSON.stringify({
          customization: product.customization,
          colors: product.colors,
          productName: product.name,
        })}
      />
    </aside>
  </main>

  {hasSizeGuide && (
    <div class="sg-overlay" data-size-guide hidden>
      <div class="sg-backdrop" data-size-guide-close></div>
      <div class="sg-modal" role="dialog" aria-modal="true" aria-label="Guía de tallas">
        <div class="sg-head">
          <div>
            <h2 class="sg-title">Guía de tallas</h2>
            <p class="sg-sub">
              Medidas en {sizeUnit || 'cm'}. {product.name}
            </p>
          </div>
          <button type="button" class="sg-close" data-size-guide-close aria-label="Cerrar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="sg-table-wrap">
          <table class="sg-table">
            <thead>
              <tr>
                <th>Talla</th>
                {sizeChartColumns.map((col) => (
                  <th>{col}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {product.sizes.map((s) => (
                <tr>
                  <td class="sg-size-name">{s.label ?? s.name}</td>
                  {sizeChartColumns.map((col) => (
                    <td>{s.measurements?.[col] ?? '—'}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}

  <Footer />
</Layout>

<script>
  import { renderCustomSession } from '../../lib/storefront';
  import {
    getCustomerToken,
    isCustomerLoggedIn,
    clearCustomerSession,
  } from '../../lib/customer';
  import type { StorefrontCustomization } from '../../lib/types';

  const root = document.querySelector<HTMLElement>('[data-pdp]');
  if (root) {
    const marquee = root.querySelector<HTMLElement>('[data-marquee]');
    const carousel = root.querySelector<HTMLElement>('[data-carousel]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]');
    const swatches = root.querySelectorAll<HTMLButtonElement>('[data-swatches] .swatch');
    const label = root.querySelector<HTMLElement>('[data-color-label]');

    // Estado del "diseño propio" activo (null = producto normal). Guarda lo
    // necesario para re-renderizar la sesión al cambiar de color.
    interface CustomState {
      customization: StorefrontCustomization;
      imageUrl: string;
      placement: {
        xPx: number;
        yPx: number;
        widthPx: number;
        heightPx: number;
        rotation?: number;
      };
      productName: string;
      /** Nº total de mockups de la sesión (para el gate de registro). */
      totalMockups: number;
      /** Imágenes ya renderizadas por color (colorId o "__nocolor__"). */
      cache: Record<string, string[]>;
      /** Color activo cuando se hizo el preview gratis. */
      previewColorId: string;
      /** Hex del color del preview (para tintar). */
      previewColorHex: string;
      /** Primera imagen (preview gratis), para el gate. */
      previewImage: string;
    }
    let customState: CustomState | null = null;

    // Alterna el modo "diseño propio": cambia el texto del botón de compra.
    const buyBtnEl = root.querySelector<HTMLButtonElement>('[data-buy] span');
    const setCustomMode = (on: boolean) => {
      if (buyBtnEl) buyBtnEl.textContent = on ? 'Comprar mi diseño' : 'Comprar';
    };

    // --- Carrusel mobile (swipe) ---
    // Reconstruye las slides y los puntos para un color dado.
    const buildCarousel = (images: string[], name: string) => {
      if (!carousel) return;
      carousel.innerHTML = images
        .map(
          (url, i) =>
            `<div class="carousel-slide"><img src="${url}" alt="${name} ${i + 1}" loading="lazy" /></div>`,
        )
        .join('');
      if (dotsWrap) {
        dotsWrap.innerHTML = images
          .map((_, i) => `<span class="dot${i === 0 ? ' active' : ''}"></span>`)
          .join('');
      }
      carousel.scrollTo({ left: 0 });
    };

    // Actualiza el punto activo según la posición de scroll del carrusel.
    const updateDots = () => {
      if (!carousel || !dotsWrap) return;
      const w = carousel.clientWidth || 1;
      const index = Math.round(carousel.scrollLeft / w);
      dotsWrap
        .querySelectorAll('.dot')
        .forEach((d, i) => d.classList.toggle('active', i === index));
    };

    if (carousel) {
      let raf = 0;
      carousel.addEventListener(
        'scroll',
        () => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            raf = 0;
            updateDots();
          });
        },
        { passive: true },
      );
    }

    // Construye el track completo y reinicia la animación (cambio de layout).
    const buildMarquee = (images: string[], name: string) => {
      if (!marquee || images.length === 0) return;
      const doubled = [...images, ...images];
      marquee.innerHTML = doubled
        .map(
          (url, i) =>
            `<div class="slide"><img src="${url}" alt="${name} ${(i % images.length) + 1}" loading="lazy" /></div>`,
        )
        .join('');
      marquee.style.animation = 'none';
      void marquee.offsetWidth;
      marquee.style.setProperty('--count', String(images.length));
      marquee.style.animation = '';
    };

    // --- Gate de registro (crea tu propia camiseta) ---
    // El gate NO es un overlay global: vive dentro de cada slide bloqueado
    // del marquee. El marquee sigue animándose con normalidad.

    /**
     * Imágenes ORIGINALES del color activo (las del producto antes de
     * personalizar). Se usan de fondo borroso en los slides bloqueados del
     * gate, para insinuar que hay más vistas sin revelar el render propio.
     */
    const activeColorImages = (): string[] => {
      const active = root.querySelector<HTMLElement>(
        '[data-swatches] .swatch.active',
      );
      try {
        const arr = JSON.parse(active?.dataset.images ?? '[]');
        return Array.isArray(arr) ? (arr as string[]) : [];
      } catch {
        return [];
      }
    };

    /**
     * Construye el marquee en modo GATE: la primera imagen (preview gratis,
     * el render del diseño propio) se ve nítida; las demás posiciones usan las
     * imágenes ORIGINALES del color (borrosas), cada una con su botón de
     * registro centrado.
     */
    const buildGatedMarquee = (
      firstImage: string,
      total: number,
      name: string,
    ) => {
      if (!marquee) return;
      const originals = activeColorImages();
      const count = Math.max(total, originals.length, 1);
      const slides: string[] = [];
      for (let i = 0; i < count; i++) {
        if (i === 0) {
          slides.push(
            `<div class="slide"><img src="${firstImage}" alt="${name} ${i + 1}" loading="lazy" /></div>`,
          );
        } else {
          // Slide bloqueado: imagen ORIGINAL del color (borrosa) + CTA.
          const bg = originals[i] ?? originals[originals.length - 1] ?? firstImage;
          slides.push(
            `<div class="slide locked">` +
              `<img src="${bg}" alt="${name} ${i + 1}" loading="lazy" />` +
              `<button type="button" class="slide-gate-btn" data-gate-register>` +
              `Regístrate para ver` +
              `</button>` +
              `</div>`,
          );
        }
      }
      // Duplicado para el bucle del marquee.
      marquee.innerHTML = [...slides, ...slides].join('');
      marquee.style.animation = 'none';
      void marquee.offsetWidth;
      marquee.style.setProperty('--count', String(count));
      marquee.style.animation = '';
      // El marquee sigue animándose normalmente (sin pausar).
    };

    /**
     * Versión gate del carrusel mobile: primera imagen nítida (render propio),
     * el resto son las originales del color borrosas con su botón de registro.
     */
    const buildGatedCarousel = (
      firstImage: string,
      total: number,
      name: string,
    ) => {
      if (!carousel) return;
      const originals = activeColorImages();
      const count = Math.max(total, originals.length, 1);
      const slides: string[] = [];
      for (let i = 0; i < count; i++) {
        if (i === 0) {
          slides.push(
            `<div class="carousel-slide"><img src="${firstImage}" alt="${name} ${i + 1}" loading="lazy" /></div>`,
          );
        } else {
          const bg = originals[i] ?? originals[originals.length - 1] ?? firstImage;
          slides.push(
            `<div class="carousel-slide locked">` +
              `<img src="${bg}" alt="${name} ${i + 1}" loading="lazy" />` +
              `<button type="button" class="slide-gate-btn" data-gate-register>Regístrate para ver</button>` +
              `</div>`,
          );
        }
      }
      carousel.innerHTML = slides.join('');
      if (dotsWrap) {
        dotsWrap.innerHTML = slides
          .map((_, i) => `<span class="dot${i === 0 ? ' active' : ''}"></span>`)
          .join('');
      }
      carousel.scrollTo({ left: 0 });
    };

    const clearGate = () => {
      // Al desbloquear se reconstruye el marquee/carrusel con las imágenes
      // reales, lo que elimina los slides bloqueados y sus botones.
    };

    /**
     * Cambia las imágenes sin reiniciar la posición del slide: si el nuevo
     * color tiene el mismo número de imágenes, solo reemplaza los `src`
     * de los <img> existentes (la animación no se interrumpe). Como las
     * poses son iguales para todos los colores, el conteo siempre coincide.
     */
    const swapMarquee = (images: string[], name: string) => {
      if (!marquee || images.length === 0) return;
      const imgs = marquee.querySelectorAll('img');
      // El track está duplicado: 2 × images.length.
      if (imgs.length !== images.length * 2) {
        buildMarquee(images, name);
        return;
      }
      imgs.forEach((img, i) => {
        const url = images[i % images.length];
        if (img.getAttribute('src') !== url) img.setAttribute('src', url);
        img.setAttribute('alt', `${name} ${(i % images.length) + 1}`);
      });
    };

    // Overlay de carga sobre el escenario (para regenerar diseño propio).
    const stageEl = root.querySelector<HTMLElement>('.stage');
    const showStageLoader = (on: boolean) => {
      if (!stageEl) return;
      stageEl.classList.toggle('loading', on);
    };

    // Abre el modal de registro/login y, al autenticarse, ejecuta onDone.
    const openAuth = async (onDone: () => void) => {
      const { openCustomerAuthModal } = await import(
        '../../lib/customer-auth-modal'
      );
      openCustomerAuthModal({
        signupOrigin: window.location.pathname,
        onSuccess: () => onDone(),
      });
    };

    /**
     * Renderiza la sesión COMPLETA de un color con sesión de cliente. Maneja
     * la expiración (401 → reabrir login) y el tope por hora (403 → avisar).
     * Devuelve las imágenes o null si no se pudo.
     */
    const renderFullColor = async (
      colorId: string | undefined,
      colorHex: string | undefined,
    ): Promise<string[] | null> => {
      if (!customState) return null;
      const token = getCustomerToken();
      if (!token) return null;
      try {
        const { images } = await renderCustomSession(
          {
            productId: customState.customization.productId,
            sessionId: customState.customization.sessionId,
            imageUrl: customState.imageUrl,
            designSmartObjectUuid:
              customState.customization.designSmartObjectUuid,
            placement: customState.placement,
            colorId,
            colorHex,
          },
          token,
        );
        return images.length ? images : null;
      } catch (err) {
        const status = (err as { status?: number }).status;
        if (status === 401) {
          // Sesión expirada: limpiar y pedir login de nuevo.
          clearCustomerSession();
          throw err;
        }
        if (status === 403) {
          window.alert(
            err instanceof Error
              ? err.message
              : 'Alcanzaste el máximo de generaciones por hora.',
          );
          return null;
        }
        return null;
      }
    };

    /**
     * Genera (o reusa de caché) la sesión completa de un color en modo diseño
     * propio y la pinta. Si la sesión expiró (401) reabre el login y reintenta.
     */
    const generateColor = async (
      btn: HTMLButtonElement,
      colorId: string,
    ): Promise<void> => {
      if (!customState) return;
      const cached = customState.cache[colorId];
      if (cached) {
        buildMarquee(cached, customState.productName);
        buildCarousel(cached, customState.productName);
        return;
      }
      showStageLoader(true);
      try {
        const images = await renderFullColor(
          btn.dataset.colorId || undefined,
          btn.dataset.colorHex || undefined,
        );
        if (images && images.length > 0) {
          customState.cache[colorId] = images;
          buildMarquee(images, customState.productName);
          buildCarousel(images, customState.productName);
        }
      } catch (err) {
        // 401: sesión expirada → reabrir login y reintentar este color.
        if ((err as { status?: number }).status === 401) {
          showStageLoader(false);
          await openAuth(() => void generateColor(btn, colorId));
          return;
        }
      } finally {
        showStageLoader(false);
      }
    };

    /**
     * Desbloquea la sesión completa del color del preview: renderiza todas las
     * imágenes (requiere sesión), quita el gate y las pinta. Asume que ya hay
     * sesión de cliente (la verifica el llamador o reabre login si 401).
     */
    const unlockFullImages = async (): Promise<void> => {
      if (!customState) return;
      showStageLoader(true);
      try {
        const colorId =
          customState.previewColorId === '__nocolor__'
            ? undefined
            : customState.previewColorId;
        const images = await renderFullColor(
          colorId,
          customState.previewColorHex || undefined,
        );
        if (images && images.length > 0) {
          customState.cache[customState.previewColorId] = images;
          clearGate();
          buildMarquee(images, customState.productName);
          buildCarousel(images, customState.productName);
        }
      } catch (err) {
        if ((err as { status?: number }).status === 401) {
          showStageLoader(false);
          await openAuth(() => void unlockFullImages());
          return;
        }
      } finally {
        showStageLoader(false);
      }
    };

    // Gate: los botones viven dentro de los slides bloqueados del marquee
    // (se reconstruyen dinámicamente), así que se delega el click en el
    // marquee. Al autenticarse, desbloquea todas las imágenes.
    const onGateClick = async () => {
      if (isCustomerLoggedIn()) {
        await unlockFullImages();
        return;
      }
      await openAuth(() => void unlockFullImages());
    };
    const delegateGate = (el: HTMLElement | null) => {
      if (!el) return;
      el.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('[data-gate-register]')) {
          e.preventDefault();
          void onGateClick();
        }
      });
    };
    delegateGate(marquee);
    delegateGate(carousel);

    swatches.forEach((btn) => {
      btn.addEventListener('click', async () => {
        swatches.forEach((b) => b.classList.toggle('active', b === btn));
        const colorName = btn.dataset.colorName ?? '';
        if (label) label.textContent = colorName;

        // Modo "diseño propio": muestra el color desde caché o lo genera.
        if (customState) {
          const colorId = btn.dataset.colorId || '__nocolor__';
          // Caché: ese color ya se generó en esta sesión → reusar (0 renders).
          const cached = customState.cache[colorId];
          if (cached) {
            buildMarquee(cached, customState.productName);
            buildCarousel(cached, customState.productName);
            return;
          }
          // Requiere sesión de cliente para renderizar la sesión completa.
          if (!isCustomerLoggedIn()) {
            await openAuth(() => void generateColor(btn, colorId));
            return;
          }
          await generateColor(btn, colorId);
          return;
        }

        // Producto normal: cambia a las imágenes pre-generadas del color.
        let images: string[] = [];
        try {
          images = JSON.parse(btn.dataset.images ?? '[]');
        } catch {
          images = [];
        }
        swapMarquee(images, colorName);
        buildCarousel(images, colorName);
      });
    });

    const priceDisplay = root.querySelector<HTMLElement>('[data-price-display]');
    root.querySelectorAll<HTMLButtonElement>('[data-sizes] .size').forEach((btn) => {
      btn.addEventListener('click', () => {
        root
          .querySelectorAll('[data-sizes] .size')
          .forEach((b) => b.classList.toggle('active', b === btn));
        // Actualiza el precio mostrado según la talla (fallback ya aplicado
        // en el data-price del botón).
        if (priceDisplay && btn.dataset.price) {
          priceDisplay.textContent = btn.dataset.price;
        }
      });
    });

    // --- Modal Guía de tallas ---
    const sizeGuide = document.querySelector<HTMLElement>('[data-size-guide]');
    if (sizeGuide) {
      const openSizeGuide = () => {
        sizeGuide.hidden = false;
        // Fuerza reflow para que la transición de entrada se aplique.
        void sizeGuide.offsetWidth;
        sizeGuide.classList.add('open');
        document.body.style.overflow = 'hidden';
      };
      const closeSizeGuide = () => {
        sizeGuide.classList.remove('open');
        document.body.style.overflow = '';
        // Oculta tras la transición de salida.
        window.setTimeout(() => {
          sizeGuide.hidden = true;
        }, 260);
      };

      root
        .querySelectorAll<HTMLButtonElement>('[data-size-guide-open]')
        .forEach((btn) => btn.addEventListener('click', openSizeGuide));
      sizeGuide
        .querySelectorAll<HTMLElement>('[data-size-guide-close]')
        .forEach((el) => el.addEventListener('click', closeSizeGuide));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sizeGuide.hidden) closeSizeGuide();
      });
    }

    // --- Crea tu propia camiseta (modal cargado dinámicamente) ---
    const customBtn = root.querySelector<HTMLButtonElement>('[data-custom-open]');
    if (customBtn) {
      customBtn.addEventListener('click', async () => {
        const payloadEl = root.querySelector<HTMLElement>('[data-custom-payload]');
        if (!payloadEl?.textContent) return;
        let payload: {
          customization:
            | import('../../lib/types').StorefrontCustomization
            | null;
          colors: import('../../lib/types').StorefrontColor[];
          productName: string;
        };
        try {
          payload = JSON.parse(payloadEl.textContent);
        } catch {
          return;
        }
        // Sin datos de personalización no hay sobre qué renderizar.
        if (!payload.customization) {
          window.alert(
            'Este producto no admite personalización por ahora.',
          );
          return;
        }
        customBtn.disabled = true;
        try {
          // Carga el modal + Konva solo ahora (no en el bundle inicial).
          const { openCustomDesigner } = await import('../../lib/custom-designer');
          openCustomDesigner({
            customization: payload.customization,
            productName: payload.productName,
            // El color se toma del swatch activo en el detalle, leído al
            // momento de generar (no hay selector dentro del modal).
            getActiveColorId: () =>
              root.querySelector<HTMLElement>('[data-swatches] .swatch.active')
                ?.dataset.colorId || null,
            getActiveColorHex: () =>
              root.querySelector<HTMLElement>('[data-swatches] .swatch.active')
                ?.dataset.colorHex || null,
            onRendered: async ({
              images,
              totalMockups,
              imageUrl,
              placement,
            }) => {
              if (images.length === 0) return;
              // Color con el que se generó (el activo al momento de generar).
              const activeSwatch = root.querySelector<HTMLElement>(
                '[data-swatches] .swatch.active',
              );
              const colorId = activeSwatch?.dataset.colorId || '__nocolor__';
              const colorHex = activeSwatch?.dataset.colorHex || '';

              // Guarda el estado del diseño propio (aún sin desbloquear).
              customState = {
                customization: payload.customization!,
                imageUrl,
                placement,
                productName: payload.productName,
                totalMockups: Math.max(totalMockups, images.length),
                cache: {},
                previewColorId: colorId,
                previewColorHex: colorHex,
                previewImage: images[0],
              };
              setCustomMode(true);

              if (isCustomerLoggedIn()) {
                // Ya tiene sesión: desbloquea directamente la sesión completa.
                await unlockFullImages();
              } else {
                // Preview gratis: primera imagen nítida, resto borroso con un
                // CTA de registro centrado en cada slide bloqueado.
                buildGatedMarquee(
                  images[0],
                  customState.totalMockups,
                  payload.productName,
                );
                buildGatedCarousel(
                  images[0],
                  customState.totalMockups,
                  payload.productName,
                );
              }
            },
          });
        } finally {
          customBtn.disabled = false;
        }
      });
    }

    // Botón volver: regresa en el historial o cae a /tienda si no hay.
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]');
    if (backBtn) {
      backBtn.addEventListener('click', () => {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/tienda';
        }
      });
    }

    // Botón "Comprar": abre WhatsApp con una ficha del producto.
    const buyBtn = root.querySelector<HTMLButtonElement>('[data-buy]');
    if (buyBtn) {
      buyBtn.addEventListener('click', () => {
        const phone = (buyBtn.dataset.phone ?? '').replace(/\D/g, '');
        const name = buyBtn.dataset.name ?? '';
        const code = buyBtn.dataset.code ?? '';
        const url = buyBtn.dataset.url ?? window.location.href;

        // Talla y color seleccionados (si existen en la página).
        const activeSize =
          root.querySelector<HTMLElement>('[data-sizes] .size.active');
        const size =
          activeSize?.dataset.size ??
          activeSize?.textContent?.trim() ??
          '';
        const color = root.querySelector<HTMLElement>('[data-color-label]')?.textContent?.trim() ?? '';
        // Precio: el de la talla activa (ya con fallback) o el mostrado.
        const priceText =
          activeSize?.dataset.price ??
          root.querySelector<HTMLElement>('[data-price-display]')?.textContent?.trim() ??
          '';

        // Ficha del producto para el mensaje.
        const lines = [
          '¡Hola! Quiero comprar este producto:',
          '',
          `*${name}*`,
          code ? `Código: ${code}` : '',
          color ? `Color: ${color}` : '',
          size ? `Talla: ${size}` : '',
          priceText ? `Precio: ${priceText}` : '',
          '',
          url,
        ].filter(Boolean);

        const text = encodeURIComponent(lines.join('\n'));
        const waUrl = phone
          ? `https://wa.me/${phone}?text=${text}`
          : `https://wa.me/?text=${text}`;
        window.open(waUrl, '_blank', 'noopener');
      });
    }
  }
</script>

<style>
  .pdp {
    position: relative;
    background: #e9e7e1;
    color: #12120f;
    min-height: 100svh;
  }

  /* Escenario a pantalla completa */
  .stage {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #e9e7e1;
  }

  /* Loader al regenerar el diseño propio en otro color. */
  .stage.loading::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    background: rgba(233, 231, 225, 0.65);
    backdrop-filter: blur(1px);
  }
  .stage.loading::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 6;
    width: 42px;
    height: 42px;
    margin: -21px 0 0 -21px;
    border-radius: 50%;
    border: 3px solid rgba(18, 18, 15, 0.2);
    border-top-color: #12120f;
    animation: stage-spin 0.8s linear infinite;
  }
  @keyframes stage-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Gate de registro: cada slide bloqueado se ve borroso y tiene su propio
     botón centrado. El marquee sigue animándose con normalidad.
     IMPORTANTE: estos slides se inyectan por JS (innerHTML), por lo que NO
     llevan el atributo scoped de Astro. Hay que usar :global() para que las
     reglas los alcancen. */
  .marquee :global(.slide.locked) {
    position: relative;
  }
  .marquee :global(.slide.locked img) {
    filter: blur(14px) saturate(0.85);
    transform: scale(1.06);
  }
  .marquee :global(.slide.locked)::after {
    /* Velo sutil para resaltar el CTA sobre la imagen borrosa. */
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(233, 231, 225, 0.18);
    pointer-events: none;
  }
  .carousel :global(.carousel-slide.locked) {
    position: relative;
  }
  .carousel :global(.carousel-slide.locked img) {
    filter: blur(14px) saturate(0.85);
    transform: scale(1.06);
  }
  :global(.slide-gate-btn) {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
    border: none;
    cursor: pointer;
    white-space: nowrap;
    border-radius: 999px;
    padding: 0.8rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background: #12120f;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.55);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  :global(.slide-gate-btn:hover) {
    opacity: 0.92;
    transform: translate(-50%, -50%) translateY(-1px);
  }

  /* Marquee: tira horizontal que se desplaza en bucle */
  .marquee {
    --count: 2;
    display: flex;
    height: 100%;
    width: max-content;
    will-change: transform;
    animation: slide-loop calc(var(--count) * 14s) linear infinite;
  }

  @keyframes slide-loop {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Ancho fijo por slide (no depende de la altura calculada, así no
     se deforma al regenerar el marquee al cambiar de color).
     :global() para que apliquen también a los slides inyectados por JS,
     que no llevan el atributo scoped de Astro. */
  .marquee :global(.slide) {
    height: 100%;
    width: clamp(320px, 42vw, 620px);
    flex: none;
    background: #e9e7e1;
  }

  .marquee :global(.slide img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Carrusel con swipe y botón volver (solo mobile): ocultos en desktop. */
  .carousel,
