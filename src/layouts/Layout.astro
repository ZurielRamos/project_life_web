---
import logo from '../assets/logo-inkttex.svg';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para Open Graph / Twitter (1200×630, JPG/PNG). */
  image?: string;
  /** Tipo de contenido Open Graph. */
  ogType?: 'website' | 'article' | 'product';
  /** Evita indexación del buscador (p. ej. páginas de resultados). */
  noindex?: boolean;
}

const DEFAULT_OG_IMAGE = '/og.jpg';

let {
  // Título ~55 caracteres (rango recomendado 50-60 para buscadores).
  title = 'Inkttex — Tu idea, tu prenda | Ropa personalizada',
  // Description ~155 caracteres (rango recomendado para Google y social).
  description =
    'Miles de diseños para tu ropa o crea el tuyo. Estampamos camisetas, hoodies y básicos para mujer, hombre, familia y kids. Explora el catálogo.',
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Tienda resuelta por host (null en el sitio principal).
const store = Astro.locals.store;
let siteName = 'Inkttex';
let faviconHref = logo.src;
let faviconType = 'image/svg+xml';
let htmlLang = 'es';
let themeStyle: string | undefined;
if (store) {
  siteName = store.name;
  // Los títulos de las páginas mencionan la marca principal: la cambiamos.
  title =
    Astro.props.title === undefined
      ? (store.seoTitle ?? store.title ?? store.name)
      : title.replaceAll('Inkttex', store.name);
  if (Astro.props.description === undefined) {
    description = store.seoDescription ?? store.description ?? description;
  }
  // Sin imagen OG propia de la página, usamos el logo de la tienda (si hay).
  if (Astro.props.image === undefined && store.logoUrl) {
    image = store.logoUrl;
  }
  if (store.faviconUrl) {
    faviconHref = store.faviconUrl;
    faviconType = '';
  }
  htmlLang = store.locale || 'es';
  // El color viene validado como #RRGGBB por la API.
  if (store.primaryColor && /^#[0-9a-fA-F]{6}$/.test(store.primaryColor)) {
    themeStyle = `--accent:${store.primaryColor};--brand-teal:${store.primaryColor}`;
  }
}

// Solo la imagen OG por defecto del sitio tiene dimensiones/formato conocidos
// (1200×630 JPG). Para imágenes personalizadas (p. ej. fotos de producto
// remotas) omitimos los hints de tamaño/tipo y dejamos que el scraper los
// deduzca al descargarla.
const isDefaultOgImage = image === DEFAULT_OG_IMAGE;

// Origen real de la request. Detrás de Vercel el host original llega en
// x-forwarded-host; es el que ve el usuario (subdominio o dominio propio).
const forwardedHost = Astro.request.headers.get('x-forwarded-host');
const forwardedProto = Astro.request.headers
  .get('x-forwarded-proto')
  ?.split(',')[0]
  ?.trim();
const forwardedHostValue = forwardedHost?.split(',')[0]?.trim() ?? '';
// Solo aceptamos un host bien formado; si no, caemos al origen de Astro.
const requestOrigin = /^[a-z0-9.-]+(:\d+)?$/i.test(forwardedHostValue)
  ? new URL(
      `${forwardedProto === 'http' ? 'http' : 'https'}://${forwardedHostValue}`,
    )
  : new URL(Astro.url.origin);

// Base absoluta del sitio para URLs de canonical/OG.
// - En una TIENDA siempre usamos el origen real de la request: así cada
//   tienda es canónica de sí misma aunque PUBLIC_SITE_URL esté definida
//   (que apunta al sitio principal).
// - En el sitio principal preferimos `Astro.site` (PUBLIC_SITE_URL) y, si no
//   está definido, el origen de la request.
const siteUrl = store ? requestOrigin : (Astro.site ?? requestOrigin);

// URL canónica de la página actual (absoluta, sin query ni hash).
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

// La imagen OG debe ser una URL absoluta. Si ya nos pasan una absoluta la
// respetamos; si es una ruta la resolvemos contra el dominio del sitio.
const ogImageURL = /^https?:\/\//.test(image)
  ? image
  : new URL(image, siteUrl).href;
---

<!doctype html>
<html lang={htmlLang} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type={faviconType || undefined} href={faviconHref} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Telegram, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <link
      rel="preload"
      href="/fonts/rumeur.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Fuente de display para los títulos de sección.
     swap + fallback con métricas ajustadas => la fuente aparece
     cuanto antes y el intercambio no provoca reflow (sin saltos). */
  @font-face {
    font-family: 'rumeur';
    src: url('/fonts/rumeur.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'rumeur-fallback';
    src: local('Arial Bold'), local('Arial');
    font-weight: 700;
    size-adjust: 105%;
    ascent-override: 80%;
    descent-override: 20%;
    line-gap-override: 0%;
  }

  :root {
    --bg: #0b0b0b;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.14);
    /* Paleta de marca tomada del logo Inkttex. */
    --accent: #01b7bb;
    --accent-dark: #017a7d;
    --accent-soft: #58e0e3;
    --brand-teal: #01b7bb;
    --brand-yellow: #fecc2b;
    --brand-purple: #9600fc;
    --header-h: 72px;
    --font: 'Helvetica Neue', Helvetica, Arial, system-ui, -apple-system, sans-serif;
    --font-display: 'rumeur', 'rumeur-fallback', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    /* Evita cualquier scroll horizontal accidental. */
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
</style>
