---
import logo from '../assets/logo-inkttex.svg';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para Open Graph / Twitter (1200×630, JPG/PNG). */
  image?: string;
  /** Tipo de contenido Open Graph. */
  ogType?: 'website' | 'article' | 'product';
  /** Evita indexación del buscador (p. ej. páginas de resultados). */
  noindex?: boolean;
}

const DEFAULT_OG_IMAGE = '/og.png';

const {
  title = 'Inkttex — Tu idea, tu prenda',
  description =
    'Miles de diseños para tu ropa, o crea el tuyo. En Inkttex estampamos camisetas, hoodies y básicos a tu gusto para mujer, hombre, familia y kids. Explora el catálogo o descríbenos lo que imaginas.',
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Solo la imagen OG por defecto del sitio tiene dimensiones/formato conocidos
// (1200×630 PNG). Para imágenes personalizadas (p. ej. fotos de producto
// remotas) omitimos los hints de tamaño/tipo y dejamos que el scraper los
// deduzca al descargarla.
const isDefaultOgImage = image === DEFAULT_OG_IMAGE;

// Base absoluta del sitio. En producción se configura con PUBLIC_SITE_URL y se
// refleja en `site` de astro.config.mjs (Astro.site). Fallback por si no está.
const siteUrl = Astro.site ?? new URL('https://www.inkttex.com');

// URL canónica de la página actual (absoluta, sin query ni hash).
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

// La imagen OG debe ser una URL absoluta. Si ya nos pasan una absoluta la
// respetamos; si es una ruta la resolvemos contra el dominio del sitio.
const ogImageURL = /^https?:\/\//.test(image)
  ? image
  : new URL(image, siteUrl).href;

const siteName = 'Inkttex';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Telegram, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <link
      rel="preload"
      href="/fonts/rumeur.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Fuente de display para los títulos de sección.
     swap + fallback con métricas ajustadas => la fuente aparece
     cuanto antes y el intercambio no provoca reflow (sin saltos). */
  @font-face {
    font-family: 'rumeur';
    src: url('/fonts/rumeur.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'rumeur-fallback';
    src: local('Arial Bold'), local('Arial');
    font-weight: 700;
    size-adjust: 105%;
    ascent-override: 80%;
    descent-override: 20%;
    line-gap-override: 0%;
  }

  :root {
    --bg: #0b0b0b;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.14);
    /* Paleta de marca tomada del logo Inkttex. */
    --accent: #01b7bb;
    --accent-dark: #017a7d;
    --accent-soft: #58e0e3;
    --brand-teal: #01b7bb;
    --brand-yellow: #fecc2b;
    --brand-purple: #9600fc;
    --header-h: 72px;
    --font: 'Helvetica Neue', Helvetica, Arial, system-ui, -apple-system, sans-serif;
    --font-display: 'rumeur', 'rumeur-fallback', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    /* Evita cualquier scroll horizontal accidental. */
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
</style>
