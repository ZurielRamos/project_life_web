---
import { bgSources } from '../lib/bg-images';
import { imageAt, imageSrcset } from '../lib/images';

interface Props {
  id?: string;
  /** Nombre base de la imagen optimizada incluida (p. ej. "bg_mujer"). */
  base?: string;
  /** Nombre base de la variante mobile opcional (p. ej. "bg_mujer_mobile"). */
  baseMobile?: string;
  /** Imágenes propias de la tienda (Cloudinary); tienen prioridad. */
  imageUrl?: string;
  mobileImageUrl?: string;
  alt: string;
  kicker?: string;
  title: string;
  href?: string;
  cta?: string;
}

const {
  id,
  base,
  baseMobile,
  imageUrl,
  mobileImageUrl,
  alt,
  kicker,
  title,
  href = '#',
  cta = 'Ver más',
} = Astro.props;

// Imágenes ya optimizadas a AVIF en local (sin transformación en runtime).
const desktop = base ? bgSources(base) : null;
const mobile = baseMobile ? bgSources(baseMobile) : null;
const customMobile = mobileImageUrl || imageUrl || '';
---

<section id={id} class="tile" data-tile>
  <a class="tile-link" href={href} aria-label={title}>
    {(imageUrl || desktop) && (
      <picture>
        {customMobile ? (
          <source
            media="(max-width: 767px)"
            srcset={imageSrcset(customMobile, [480, 768, 1080]) || customMobile}
            sizes="100vw"
          />
        ) : (
          mobile && (
            <source
              media="(max-width: 767px)"
              type="image/avif"
              srcset={mobile.avifSrcset}
              sizes="100vw"
            />
          )
        )}
        {imageUrl ? (
          <source
            srcset={imageSrcset(imageUrl, [1280, 1920, 2560]) || imageUrl}
            sizes="100vw"
          />
        ) : (
          desktop && (
            <source type="image/avif" srcset={desktop.avifSrcset} sizes="100vw" />
          )
        )}
        <img
          src={imageUrl ? imageAt(imageUrl, 1920) : desktop?.fallback}
          alt={alt}
          class="tile-img"
          width="2752"
          height="1536"
          loading="lazy"
          decoding="async"
        />
      </picture>
    )}
    <div class="tile-veil"></div>
  </a>

  <div class="tile-contentwrap">
    <div class="tile-content" data-tile-content>
      {kicker && <span class="tile-kicker">{kicker}</span>}
      <h2 class="tile-title">{title}</h2>
      <a class="tile-cta" href={href}>{cta}</a>
    </div>
  </div>
</section>

<style>
  .tile {
    position: relative;
    width: 100%;
    height: 100svh;
    max-height: 100svh;
    overflow: hidden;
    background: #111;
  }

  .tile-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
  }

  .tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .tile:hover .tile-img {
    transform: scale(1.04);
  }

  /* Velo de contraste. En desktop el texto va a la derecha, así que oscurecemos
     ese lado de borde a borde (degradado horizontal limpio, sin manchas). */
  .tile-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 40%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  /* En desktop el wrapper es transparente al layout. */
  .tile-contentwrap {
    display: contents;
  }

  /* Bloque de título. En desktop va alineado a la DERECHA; entra centrado
     verticalmente y, al scrollear, GSAP lo desliza hasta el fondo de la
     sección (mismo efecto que en mobile). El anclaje vertical es top:50% y
     el centrado exacto + el recorrido los controla GSAP (yPercent / y). */
  .tile-content {
    position: absolute;
    right: 0;
    left: auto;
    top: 50%;
    bottom: auto;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 0.4rem;
    /* padding lateral/superior amplio, pero inferior reducido para que el
       texto quede ligeramente más abajo al final del recorrido en desktop. */
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem) 1rem;
    pointer-events: none;
    will-change: transform;
    /* Sombra sutil para afinar el contraste; el grueso lo aporta el velo. */
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .tile-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  .tile-cta {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #2fd1de;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    width: fit-content;
    pointer-events: auto;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .tile:hover .tile-cta,
  .tile-cta:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    /* El título se mueve con GSAP (position:absolute) dentro de la sección,
       así que mantenemos overflow:hidden (heredado) para recortar el velo
       del texto y evitar scroll horizontal. */

    /* En mobile el texto va centrado y recorre la sección verticalmente, así
       que el velo lateral de desktop no sirve. Usamos un velo vertical que
       oscurece centro e inferior (donde vive y termina el texto) dejando la
       parte superior de la foto más limpia. */
    .tile-veil {
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.1) 0%,
        rgba(0, 0, 0, 0.45) 50%,
        rgba(0, 0, 0, 0.6) 100%
      );
    }

    .tile-contentwrap {
      display: contents;
    }

    /* Estado base: el título centrado verticalmente dentro de su sección.
       GSAP ScrollTrigger (ver <script>) anima su "y" desde el centro hasta
       el fondo de la sección, ligado al scroll (scrub). */
    .tile-content {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      bottom: auto; /* anula el bottom:0 del estado desktop */
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.4rem;
      pointer-events: none;
      will-change: transform;
      /* Poco padding inferior para que el título quede bien abajo al final. */
      padding: 1.25rem 1.25rem 0.5rem;
      /* El centrado vertical exacto lo aplica GSAP con yPercent:-50, para no
         pisar el transform que anima la posición (y). */
    }

    .tile-kicker {
      font-size: 0.82rem;
    }

    .tile-title {
      font-size: clamp(3rem, 13vw, 4.5rem);
    }

    .tile-cta {
      opacity: 1;
      transform: none;
      margin-inline: auto;
      pointer-events: auto;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Efecto del título (mobile y desktop):
  //   - Entra CENTRADO verticalmente en su sección.
  //   - Al scrollear, se desliza hacia abajo y queda PEGADO al fondo de su
  //     propia sección (nunca por encima del centro).
  //   - La alineación horizontal la define el CSS: centrado en mobile,
  //     alineado a la derecha en desktop. La animación vertical es la misma.
  // Lo resolvemos con GSAP ScrollTrigger + scrub (ligado al scroll). Animamos
  // la propiedad "y" del título desde 0 (centro) hasta el desplazamiento que
  // lo lleva al fondo de la sección.
  const MQ = '(min-width: 0px)';

  function buildTileAnimations() {
    const tiles = gsap.utils.toArray<HTMLElement>('[data-tile]');

    tiles.forEach((tile) => {
      const content = tile.querySelector<HTMLElement>('[data-tile-content]');
      if (!content) return;

      // El título está anclado con top:50% (su borde superior en el centro de
      // la sección). yPercent:-50 lo sube la mitad de su propio alto => queda
      // CENTRADO verticalmente. GSAP combina yPercent e y en el mismo
      // transform, así que animar "y" no pisa el centrado.
      gsap.set(content, { yPercent: -50 });

      // 0 => el título baja hasta el fondo de la sección. El pequeño respiro
      // respecto al borde lo da el padding inferior del .tile-content.
      const bottomPad = 0;
      const travel = () =>
        tile.offsetHeight / 2 - content.offsetHeight / 2 - bottomPad;

      gsap.fromTo(
        content,
        { y: 0 },
        {
          y: travel,
          ease: 'none',
          scrollTrigger: {
            trigger: tile,
            // start: sección encuadrada (su top en el top del viewport) => y=0
            //        => título CENTRADO.
            // end:   la sección termina de salir por arriba (su bottom en el
            //        top del viewport). Durante ese tramo (un viewport de
            //        scroll) el título baja del centro al fondo de la sección.
            start: 'top top',
            end: 'bottom top',
            scrub: true,
            invalidateOnRefresh: true,
          },
        },
      );
    });
  }

  function initTileScroll() {
    // Limpia triggers previos (navegación client-side / resize de breakpoint).
    ScrollTrigger.getAll().forEach((st) => st.kill());
    gsap.set('[data-tile-content]', { clearProps: 'transform' });

    // Aplica en todos los anchos (mobile y desktop). matchMedia de GSAP
    // reconstruye la animación en resize y recalcula medidas.
    const mm = gsap.matchMedia();
    mm.add(MQ, () => {
      buildTileAnimations();
      ScrollTrigger.refresh();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTileScroll);
  } else {
    initTileScroll();
  }
  // Recalcular tras cargar imágenes (cambian alturas) y en navegación Astro.
  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:page-load', initTileScroll);
</script>
