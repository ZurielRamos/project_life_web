---
import logo from '../assets/logo-inkttex.svg';
import {
  DEFAULT_BRAND_DESCRIPTION,
  getBrand,
  getRequestOrigin,
  hexToRgb,
  ogLocale,
} from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para Open Graph / Twitter (1200×630, JPG/PNG). */
  image?: string;
  /** Tipo de contenido Open Graph. */
  ogType?: 'website' | 'article' | 'product';
  /** Evita indexación del buscador (p. ej. páginas de resultados). */
  noindex?: boolean;
}

// Marca efectiva de la petición (tienda resuelta por host).
const brand = getBrand(Astro.locals.store);

const DEFAULT_OG_IMAGE = '/og.jpg';

const {
  // Por defecto, el título SEO de la tienda.
  title = brand.title,
  // Por defecto, la descripción SEO o la descripción de la tienda.
  description = brand.seoDescription ??
    brand.description ??
    DEFAULT_BRAND_DESCRIPTION,
  // Sin imagen propia: logo de la tienda; solo la plataforma (sin tienda)
  // tiene una imagen OG por defecto.
  image = brand.logoUrl ?? (brand.isDefault ? DEFAULT_OG_IMAGE : undefined),
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Icono de pestaña: el de la tienda, su logo o, sin tienda, el de la plataforma.
const faviconHref =
  brand.faviconUrl ?? brand.logoUrl ?? (brand.isDefault ? logo.src : null);
const faviconType = brand.faviconUrl || brand.logoUrl ? undefined : 'image/svg+xml';

// El color viene validado como #RRGGBB.
const themeStyle = brand.primaryColor
  ? [
      `--accent:${brand.primaryColor}`,
      `--brand-teal:${brand.primaryColor}`,
      `--accent-rgb:${hexToRgb(brand.primaryColor)}`,
      `--accent-dark:color-mix(in srgb, ${brand.primaryColor} 70%, #000)`,
      `--accent-soft:color-mix(in srgb, ${brand.primaryColor} 65%, #fff)`,
    ].join(';')
  : undefined;

// Solo la imagen OG por defecto de la plataforma tiene dimensiones/formato
// conocidos (1200×630 JPG). Para el resto omitimos los hints de tamaño/tipo y
// dejamos que el scraper los deduzca al descargarla.
const isDefaultOgImage = image === DEFAULT_OG_IMAGE;

// Base absoluta para canonical/OG: siempre el origen real de la petición, así
// cada tienda es canónica de sí misma (subdominio o dominio propio).
const siteUrl = getRequestOrigin(Astro.request, Astro.url);

// URL canónica de la página actual (absoluta, sin query ni hash).
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

// La imagen OG debe ser una URL absoluta. Si ya nos pasan una absoluta la
// respetamos; si es una ruta la resolvemos contra el dominio del sitio.
const ogImageURL = image
  ? /^https?:\/\//.test(image)
    ? image
    : new URL(image, siteUrl).href
  : null;
---

<!doctype html>
<html
  lang={brand.locale}
  style={themeStyle}
  data-brand-name={brand.name}
  data-brand-logo={brand.logoUrl ?? undefined}
  data-brand-default={brand.isDefault ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faviconHref && <link rel="icon" type={faviconType} href={faviconHref} />}
    <meta name="generator" content={Astro.generator} />

    <!-- SEO base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Telegram, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={ogLocale(brand.locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && (
      <>
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:secure_url" content={ogImageURL} />
        {isDefaultOgImage && (
          <>
            <meta property="og:image:type" content="image/jpeg" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
          </>
        )}
        <meta property="og:image:alt" content={title} />
      </>
    )}

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content={ogImageURL ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && (
      <>
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={title} />
      </>
    )}

    <link
      rel="preload"
      href="/fonts/rumeur.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Fuente de display para los títulos de sección.
     swap + fallback con métricas ajustadas => la fuente aparece
     cuanto antes y el intercambio no provoca reflow (sin saltos). */
  @font-face {
    font-family: 'rumeur';
    src: url('/fonts/rumeur.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'rumeur-fallback';
    src: local('Arial Bold'), local('Arial');
    font-weight: 700;
    size-adjust: 105%;
    ascent-override: 80%;
    descent-override: 20%;
    line-gap-override: 0%;
  }

  :root {
    --bg: #0b0b0b;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.14);
    /* Paleta de marca tomada del logo Inkttex. */
    --accent: #01b7bb;
    --accent-dark: #017a7d;
    --accent-soft: #58e0e3;
    --accent-rgb: 1, 183, 187;
    --brand-teal: #01b7bb;
    --brand-yellow: #fecc2b;
    --brand-purple: #9600fc;
    --header-h: 72px;
    --font: 'Helvetica Neue', Helvetica, Arial, system-ui, -apple-system, sans-serif;
    --font-display: 'rumeur', 'rumeur-fallback', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    /* Evita cualquier scroll horizontal accidental. */
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
</style>
