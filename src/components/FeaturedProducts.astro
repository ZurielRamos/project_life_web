---
import ProductCard from './ProductCard.astro';
import { listStorefrontDesigns } from '../lib/storefront';
import type { FeaturedSection } from '../lib/site';

interface Props {
  section: FeaturedSection;
}

const { section } = Astro.props;
const store = Astro.locals.store?.slug;
// Secciones guardadas antes de existir estas opciones: valores por defecto.
const mode = section.mode ?? 'auto';
const columns = section.columns ?? 4;
const limit = Math.min(Math.max(section.limit ?? 8, 2), 24);
const manualIds = (section.designIds ?? []).slice(0, limit);

// Modo manual: los diseños elegidos, en su orden. Automático: la consulta.
const result =
  mode === 'manual'
    ? manualIds.length
      ? await listStorefrontDesigns({ ids: manualIds, limit, store })
      : { items: [], total: 0, limit, offset: 0 }
    : await listStorefrontDesigns({
        fit: section.fit || undefined,
        category: section.category || undefined,
        q: section.query || undefined,
        product: section.productId || undefined,
        sort: section.sort ?? 'newest',
        limit,
        store,
      });
const titleId = `${section.id}-title`;
const image = section.image ?? '1';
const imagePick = image === 'random' ? 'random' : Number(image) - 1;
const randomExclude = (section.randomExclude ?? 0) - 1;
---
{result.items.length > 0 && (
  <section
    id={section.id}
    class="featured"
    aria-labelledby={section.title ? titleId : undefined}
    aria-label={section.title ? undefined : 'Productos destacados'}
    style={`--featured-cols:${columns}`}
  >
    <div class="featured-head">
      <div>
        {section.title && <h2 id={titleId} class="featured-title">{section.title}</h2>}
        {section.subtitle && <p class="featured-sub">{section.subtitle}</p>}
      </div>
      {section.ctaLabel && (
        <a class="featured-cta" href={section.ctaUrl}>{section.ctaLabel}</a>
      )}
    </div>
    <!-- Escritorio: cuadrícula. Móvil: slider horizontal con tarjetas compactas. -->
    <ul class="featured-track" role="list" tabindex="0" aria-label={section.title || 'Productos destacados'}>
      {result.items.map((product) => (
        <li class="featured-item">
          <ProductCard product={product} compact imagePick={imagePick} randomExclude={randomExclude} />
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .featured {
    background: #f4f2ee;
    color: #12120f;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem);
  }
  .featured-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .featured-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.1;
  }
  .featured-sub {
    margin: 0.5rem 0 0;
    color: #6b6b63;
  }
  .featured-cta {
    flex: none;
    border: 1px solid #12120f;
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    color: #12120f;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .featured-cta:hover {
    background: #12120f;
    color: #fff;
  }
  .featured-cta:focus-visible,
  .featured-track:focus-visible {
    outline: 3px solid rgba(var(--accent-rgb), 0.5);
    outline-offset: 3px;
  }
  .featured-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--featured-cols, 4), minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .featured-item {
    min-width: 0;
  }
  /* Tablet: como mucho 3 columnas. */
  @media (max-width: 1024px) {
    .featured-track {
      grid-template-columns: repeat(min(var(--featured-cols, 4), 3), minmax(0, 1fr));
    }
  }
  /* Móvil: slider horizontal con desplazamiento por tarjeta. Se ven dos
     tarjetas y asoma la siguiente para invitar a deslizar. */
  @media (max-width: 760px) {
    .featured-head {
      align-items: center;
    }
    .featured-cta {
      padding: 0.45rem 1rem;
      font-size: 0.8rem;
    }
    .featured-track {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(1rem, 4vw, 3rem);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* El slider llega al borde de la pantalla; el padding mantiene la
         primera tarjeta alineada con el título. */
      margin-inline: calc(-1 * clamp(1rem, 4vw, 3rem));
      padding-inline: clamp(1rem, 4vw, 3rem);
      padding-bottom: 0.25rem;
    }
    .featured-track::-webkit-scrollbar {
      display: none;
    }
    .featured-item {
      flex: 0 0 42%;
      scroll-snap-align: start;
    }
  }
  @media (max-width: 380px) {
    .featured-item {
      flex-basis: 46%;
    }
  }
</style>
