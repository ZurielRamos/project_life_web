---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CategoryTile from '../components/CategoryTile.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import FeaturedSkeleton from '../components/FeaturedSkeleton.astro';
import BannerBlock from '../components/BannerBlock.astro';
import TextBlock from '../components/TextBlock.astro';
import Footer from '../components/Footer.astro';
import { getBrand } from '../lib/brand';
import type { HomeSection } from '../lib/site';

// Las secciones del home (orden, visibilidad y contenido) las define la tienda.
const brand = getBrand(Astro.locals.store);
const sections = brand.site.home.sections.filter((s) => s.enabled);

/** Ancla a la que apunta el enlace "Explora…" del hero. */
const anchorOf = (section: HomeSection | undefined): string | undefined => {
  if (!section) return undefined;
  if (section.type === 'categories') {
    return section.tiles.find((t) => t.enabled)?.id;
  }
  return section.id;
};
---
<Layout>
  <Header />
  <main>
    {sections.map((section, index) => {
      switch (section.type) {
        case 'hero':
          return <Hero section={section} scrollTo={anchorOf(sections[index + 1])} />;
        case 'categories':
          return (
            <section class="categories" aria-label="Categorías">
              {section.tiles
                .filter((tile) => tile.enabled)
                .map((tile) => (
                  <CategoryTile
                    id={tile.id}
                    base={tile.defaultImage || undefined}
                    baseMobile={tile.defaultImage ? `${tile.defaultImage}_mobile` : undefined}
                    imageUrl={tile.imageUrl || undefined}
                    mobileImageUrl={tile.mobileImageUrl || undefined}
                    alt={tile.title}
                    kicker={tile.kicker}
                    title={tile.title}
                    href={tile.url}
                    cta={tile.cta}
                  />
                ))}
            </section>
          );
        case 'featured':
          // Server island: la página no espera a la API; mientras tanto, skeleton.
          return (
            <FeaturedProducts server:defer section={section}>
              <FeaturedSkeleton slot="fallback" section={section} />
            </FeaturedProducts>
          );
        case 'banner':
          return <BannerBlock section={section} />;
        case 'text':
          return <TextBlock section={section} />;
      }
    })}
  </main>
  <Footer />
</Layout>
<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg);
  }
</style>
