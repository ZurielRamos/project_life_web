# URL base de la API pública (NestJS). Incluye el prefijo /api.
# En desarrollo la API corre en http://localhost:3000/api
PUBLIC_API_URL=http://localhost:3000/api
# Número de WhatsApp (solo dígitos, con código de país si aplica) al que se
# envía el pedido desde el botón "Comprar" de la página de producto.
PUBLIC_WHATSAPP_PHONE=573207104999
