---
// Las tiendas no usan el home de marca: van directo a su catálogo.
if (Astro.locals.store) {
  return Astro.redirect('/tienda');
}
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CategoryTile from '../components/CategoryTile.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <main>
    <Hero />

    <section class="categories" aria-label="Categorías">
      <CategoryTile
        id="women"
        base="bg_mujer"
        baseMobile="bg_mujer_mobile"
        alt="Ropa de mujer"
        kicker="Lo nuevo en ella"
        title="Mujer"
        href="/tienda?fit=women"
        cta="Descubre su estilo"
      />
      <CategoryTile
        id="family"
        base="bg_familia"
        baseMobile="bg_familia_mobile"
        alt="Ropa familiar"
        kicker="Juntos, a juego"
        title="Familiar"
        href="/tienda?fit=family"
        cta="Explora los looks"
      />
      <CategoryTile
        id="men"
        base="bg_hombre"
        baseMobile="bg_hombre_mobile"
        alt="Ropa de hombre"
        kicker="Corte oversize"
        title="Hombre"
        href="/tienda?fit=men"
        cta="Descubre su estilo"
      />
      <CategoryTile
        id="hoodies"
        base="bg_hoodie"
        baseMobile="bg_hoodie_mobile"
        alt="Ropa unisex"
        kicker="Básicos sin género"
        title="Unisex"
        href="/tienda?fit=unisex"
        cta="Explora los esenciales"
      />
      <CategoryTile
        id="kids"
        base="bg_kids"
        baseMobile="bg_kids_mobile"
        alt="Ropa infantil"
        kicker="Estilo en miniatura"
        title="Kids"
        href="/tienda?fit=kids"
        cta="Descubre Mini Inkttex"
      />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg);
  }
</style>
