---
// Embebemos el SVG del logo inline para recolorearlo. En el footer (fondo
// oscuro) usamos la misma variante que el header al scrollear: la parte oscura
// (.st0) en blanco, conservando los colores de marca.
import logoSvg from '../assets/logo-inkttex.svg?raw';

import { getBrand } from '../lib/brand';
const brand = getBrand(Astro.locals.store);
// Contenido del pie configurado en la tienda.
const footer = brand.site.footer;
const columns = footer.columns;
const year = new Date().getFullYear();

// Opciones de diseño (con valores por defecto = pie original).
const layout = footer.layout ?? 'columns';
const appearance = footer.appearance ?? 'dark';
const showLogo = footer.showLogo ?? true;
const logoSize = footer.logoSize ?? 'md';
const mobileColumns = footer.mobileColumns ?? 'hidden';
const cta = footer.cta?.label && footer.cta?.url ? footer.cta : null;
const bottomNote = footer.bottomNote ?? '';
const showBackToTop = footer.showBackToTop ?? false;
const isExternal = (url: string) => /^https?:\/\//i.test(url);
// Enlaces legales: los del pie + las páginas marcadas «en el pie» (sin repetir).
const legalLinks = [
  ...footer.legalLinks,
  ...brand.site.pages
    .filter((p) => p.published && p.inFooter)
    .map((p) => ({ label: p.title, url: `/p/${p.slug}` })),
].filter((link, i, all) => all.findIndex((l) => l.url === link.url) === i);
const footerClass = [
  'footer',
  `layout-${layout}`,
  `look-${appearance}`,
  `logo-${logoSize}`,
  `mcols-${mobileColumns}`,
].join(' ');

// Redes y contacto: salen de la configuración de la tienda (cada icono solo
// aparece si el dato existe).
const socials = !footer.showSocial ? [] : [
  brand.instagram && { name: 'Instagram', href: brand.instagram, icon: 'instagram' },
  brand.facebook && { name: 'Facebook', href: brand.facebook, icon: 'facebook' },
  brand.tiktok && { name: 'TikTok', href: brand.tiktok, icon: 'tiktok' },
  brand.whatsappDigits && {
    name: 'WhatsApp',
    href: `https://wa.me/${brand.whatsappDigits}`,
    icon: 'whatsapp',
  },
  brand.contactEmail && {
    name: 'Correo',
    href: `mailto:${brand.contactEmail}`,
    icon: 'email',
  },
].filter(Boolean) as { name: string; href: string; icon: string }[];
---

<footer class={footerClass}>
  <div class="footer-top">
    <div class="footer-brand">
      {!showLogo ? null : brand.logoUrl ? (
        <img class="footer-logo store-footer-logo" src={brand.logoUrl} alt={brand.name} />
      ) : brand.isDefault ? (
        <span class="footer-logo" role="img" aria-label={brand.name} set:html={logoSvg}></span>
      ) : (
        <span class="footer-logo store-footer-name">{brand.name}</span>
      )}
      {(footer.about || brand.tagline || brand.description) && (
        <p class="footer-tag">{footer.about || brand.tagline || brand.description}</p>
      )}
      {footer.showContactInfo && (brand.phone || brand.address) && (
        <p class="footer-tag">
          {brand.phone}{brand.phone && brand.address ? ' · ' : ''}{brand.address}
        </p>
      )}

      {cta && (
        <a
          class="footer-cta"
          href={cta.url}
          target={isExternal(cta.url) ? '_blank' : undefined}
          rel={isExternal(cta.url) ? 'noopener noreferrer' : undefined}
        >{cta.label}</a>
      )}

      {socials.length > 0 && (
      <ul class="footer-social">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="footer-social-link"
              target={s.icon === 'email' ? undefined : '_blank'}
              rel={s.icon === 'email' ? undefined : 'noopener noreferrer'}
              aria-label={s.name}
            >
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.86.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.52.01-4.76.07-.9.04-1.38.2-1.7.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.28.8-.32 1.7C3.4 8.48 3.4 8.85 3.4 12s0 3.52.07 4.76c.04.9.2 1.38.32 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.8.28 1.7.32 1.24.06 1.61.07 4.76.07s3.52 0 4.76-.07c.9-.04 1.38-.2 1.7-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.28-.8.32-1.7.06-1.24.07-1.61.07-4.76s0-3.52-.07-4.76c-.04-.9-.2-1.38-.32-1.7a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.12-.8-.28-1.7-.32C15.52 4.01 15.15 4 12 4Zm0 3.06A4.94 4.94 0 1 1 7.06 12 4.94 4.94 0 0 1 12 7.06Zm0 8.14A3.2 3.2 0 1 0 8.8 12 3.2 3.2 0 0 0 12 15.2Zm6.3-8.34a1.15 1.15 0 1 1-1.15-1.15 1.15 1.15 0 0 1 1.15 1.15Z"/>
                </svg>
              )}
              {s.icon === 'facebook' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/>
                </svg>
              )}
              {s.icon === 'whatsapp' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
                </svg>
              )}
              {s.icon === 'tiktok' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              )}
              {s.icon === 'email' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
      )}
    </div>

    {columns.length > 0 && (
    <div class="footer-cols" style={`--footer-cols:${Math.min(columns.length, 4)}`}>
      {columns.map((col) => (
        <!-- <details> abierto: en escritorio siempre se ve; en móvil con
             "desplegables" el script lo cierra y funciona como acordeón. -->
        <details class="footer-col" open>
          <summary>
            <h3>{col.title}</h3>
            <svg class="footer-col-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={isExternal(link.url) ? '_blank' : undefined}
                  rel={isExternal(link.url) ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    )}
  </div>
  <div class="footer-bottom">
    <p>{footer.copyright || `© ${year} ${brand.name}. Todos los derechos reservados.`}</p>
    {bottomNote && <p class="footer-note">{bottomNote}</p>}
    {legalLinks.length > 0 && (
      <ul class="legal">
        {legalLinks.map((link) => (
          <li><a href={link.url}>{link.label}</a></li>
        ))}
      </ul>
    )}
    {showBackToTop && (
      <a class="footer-top-link" href="#">
        Volver arriba
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
      </a>
    )}
  </div>
</footer>

{mobileColumns === 'accordion' && columns.length > 0 && (
  <script>
    // Acordeón solo en móvil: cerradas al entrar; en escritorio siempre abiertas.
    const mq = matchMedia('(max-width: 860px)');
    const sync = () => {
      document.querySelectorAll<HTMLDetailsElement>('.mcols-accordion .footer-col').forEach((d) => {
        d.open = !mq.matches;
      });
    };
    sync();
    mq.addEventListener('change', sync);
  </script>
)}

<style>
  .store-footer-logo {
    object-fit: contain;
    max-height: 48px;
    width: auto;
  }
  .store-footer-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fg);
  }

  .footer {
    border-top: 1px solid var(--line);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem) 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  /* Logo inline: fijamos la altura y el svg interno mantiene su proporción. */
  .footer-logo {
    display: inline-flex;
    height: 42px;
  }

  .footer-logo :global(svg) {
    height: 100%;
    width: auto;
    display: block;
  }

  /* Igual que el header al hacer scroll: solo la parte oscura del logo (.st0)
     pasa a blanco. Los colores de marca (teal, amarillo, morado) se conservan. */
  .footer-logo :global(.st0) {
    fill: #ffffff;
  }

  .footer-tag {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 22rem;
  }

  /* Iconos de redes sociales bajo la descripción. */
  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--fg);
    transition: background 0.2s ease, border-color 0.2s ease,
      transform 0.2s ease, color 0.2s ease;
  }

  .footer-social-link:hover {
    background: rgba(var(--accent-rgb), 0.16);
    border-color: rgba(var(--accent-rgb), 0.7);
    color: var(--accent-soft);
    transform: translateY(-2px);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(max(var(--footer-cols, 3), 3), 1fr);
    gap: 1.5rem;
  }

  .footer-col summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    /* Solo es un botón en el acordeón móvil (ver media query). */
    pointer-events: none;
  }

  .footer-col summary::-webkit-details-marker {
    display: none;
  }

  .footer-col-chevron {
    display: none;
    color: var(--muted);
    transition: transform 0.2s ease;
  }

  .footer-col h3 {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 0.6rem;
  }

  .footer-col a {
    font-size: 0.9rem;
    color: var(--footer-link);
  }

  .footer-col a:hover {
    color: var(--fg);
  }

  /* ---------- Apariencia ---------- */
  .footer {
    --footer-link: rgba(255, 255, 255, 0.82);
    color: var(--fg);
  }

  .look-light {
    --fg: #12120f;
    --muted: #6b6b63;
    --line: rgba(18, 18, 15, 0.12);
    --footer-link: #33332e;
    background: #f4f2ee;
  }

  /* Logo por defecto en fondo claro: la parte oscura vuelve a su color. */
  .look-light .footer-logo :global(.st0) {
    fill: #12120f;
  }

  .look-brand {
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.78);
    --line: rgba(255, 255, 255, 0.25);
    --footer-link: rgba(255, 255, 255, 0.9);
    background: var(--accent);
  }

  .look-brand .footer-social-link:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
    color: #ffffff;
  }

  /* ---------- Tamaño del logo ---------- */
  .logo-sm .footer-logo { height: 30px; }
  .logo-sm .store-footer-logo { max-height: 34px; }
  .logo-lg .footer-logo { height: 58px; }
  .logo-lg .store-footer-logo { max-height: 68px; }
  .logo-sm .store-footer-name { font-size: 1.15rem; }
  .logo-lg .store-footer-name { font-size: 2rem; }

  /* ---------- Botón ---------- */
  .footer-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1.25rem;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent) 40%, var(--accent-2) 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .footer-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  .look-brand .footer-cta {
    background: #ffffff;
    color: var(--accent);
  }

  .footer-cta:focus-visible,
  .footer-top-link:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }

  .footer-note {
    margin: 0;
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }

  /* ---------- Distribución ---------- */
  /* Centrado: todo apilado y al centro. */
  .layout-centered .footer-top {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }

  .layout-centered .footer-tag {
    margin-inline: auto;
  }

  .layout-centered .footer-social {
    justify-content: center;
  }

  .layout-centered .footer-cols {
    width: min(100%, 52rem);
  }

  .layout-centered .footer-col summary {
    justify-content: center;
  }

  .layout-centered .footer-bottom {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  /* Compacto: una fila con la marca a un lado y los enlaces en línea. */
  .layout-compact {
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .layout-compact .footer-top {
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  .layout-compact .footer-tag {
    display: none;
  }

  .layout-compact .footer-social {
    margin-top: 0.75rem;
  }

  .layout-compact .footer-cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.5rem;
  }

  .layout-compact .footer-col summary {
    display: none;
  }

  .layout-compact .footer-col ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .layout-compact .footer-col li {
    margin: 0;
  }

  .layout-compact .footer-bottom {
    margin-top: 1.5rem;
  }

  .footer-bottom {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    /* Columnas en móvil: ocultas, visibles (2 por fila) o acordeón (1 por fila). */
    .mcols-hidden .footer-cols {
      display: none;
    }
    .mcols-visible .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
    .mcols-accordion .footer-cols {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .mcols-accordion .footer-col {
      border-bottom: 1px solid var(--line);
    }
    .mcols-accordion .footer-col summary {
      pointer-events: auto;
      cursor: pointer;
      min-height: 48px;
      margin: 0;
    }
    .mcols-accordion .footer-col-chevron {
      display: block;
    }
    .mcols-accordion .footer-col[open] .footer-col-chevron {
      transform: rotate(180deg);
    }
    .mcols-accordion .footer-col ul {
      padding-bottom: 0.75rem;
    }
    .mcols-accordion.layout-centered .footer-col summary {
      justify-content: space-between;
    }
    .layout-compact .footer-top {
      grid-template-columns: 1fr;
    }
    .layout-compact .footer-cols {
      justify-content: flex-start;
    }
    .layout-compact.mcols-accordion .footer-col summary {
      display: flex;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .layout-centered .footer-bottom {
      align-items: center;
    }
  }
</style>
