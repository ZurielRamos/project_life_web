---
import logo from '../assets/logo.svg';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KULT — Essentials',
  description = 'Camisetas, hoodies y básicos de diseño para hombre, mujer y niños.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/rumeur.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Fuente de display para los títulos de sección.
     swap + fallback con métricas ajustadas => la fuente aparece
     cuanto antes y el intercambio no provoca reflow (sin saltos). */
  @font-face {
    font-family: 'rumeur';
    src: url('/fonts/rumeur.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'rumeur-fallback';
    src: local('Arial Bold'), local('Arial');
    font-weight: 700;
    size-adjust: 105%;
    ascent-override: 80%;
    descent-override: 20%;
    line-gap-override: 0%;
  }

  :root {
    --bg: #0b0b0b;
    --fg: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.14);
    --accent: #1f7a4d;
    --header-h: 72px;
    --font: 'Helvetica Neue', Helvetica, Arial, system-ui, -apple-system, sans-serif;
    --font-display: 'rumeur', 'rumeur-fallback', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    /* Evita cualquier scroll horizontal accidental. */
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
</style>
